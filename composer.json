{
    "name": "wonittecnologia/interage-sdk-php",
    "description": "SDK PHP oficial da API pública de clientes da plataforma Interage+ (Wonit).",
    "type": "library",
    "license": "MIT",
    "keywords": ["interage", "wonit", "whatsapp", "omnichannel", "pabx", "sdk"],
    "authors": [
        {
            "name": "Wonit Tecnologia da Informação"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "WonitTecnologia\\Interage\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WonitTecnologia\\Interage\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
